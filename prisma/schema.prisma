generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Users {
  user_id            Int       @id @default(autoincrement())
  name               String
  email              String    @unique
  phone              String?
  role               String    @default("pending_review")
  blood_group        String?
  password_hash      String
  holding_no         String?
  plot_no            String?
  status             String    @default("pending")
  relationship_type  String?
  flat_count         Int?
  rejection_reason   String?   @db.VarChar(500)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  contributionPayments ContributionPayments[]
  expensesApproved     Expenses[] @relation("ApprovedExpenses")
  fees                 Fees[]
  payrollAssignments   PayrollAssignments[]

  // Ownership records for this user
  ownerships           Ownership[]
  // Ownership transfers where this user was the previous owner
  transfersFrom        OwnershipTransfer[] @relation("TransferFrom")
  // Ownership transfers where this user is the new owner
  transfersTo          OwnershipTransfer[] @relation("TransferTo")

  @@index([plot_no], map: "Users_plot_no_idx")
  @@index([status], map: "Users_status_idx")
}

model Plot {
  plot_no     String   @id
  owner_name  String?
  size        Float    @default(0.0)
  plot_type   String   @default("single_unit")
  is_disputed Boolean  @default(false)
  dispute_notes String? @db.Text
  dispute_resolved_at DateTime?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Flats in this plot (for multi_unit plots)
  flats       Flat[]
  // Ownership records for this plot
  ownerships  Ownership[]
}

model Flat {
  flat_id     Int      @id @default(autoincrement())
  flat_no     String
  floor       Int
  plot_no     String
  created_at  DateTime @default(now())

  plot        Plot     @relation(fields: [plot_no], references: [plot_no], onDelete: Cascade)
  ownerships  Ownership[]

  @@unique([plot_no, flat_no])
  @@index([plot_no], map: "Flat_plot_no_idx")
}

model Ownership {
  ownership_id   Int       @id @default(autoincrement())
  user_id        Int
  plot_no        String
  flat_id        Int?
  ownership_type String
  status         String    @default("active")
  start_date     DateTime  @default(now())
  end_date       DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  user           Users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  plot           Plot      @relation(fields: [plot_no], references: [plot_no], onDelete: Cascade)
  flat           Flat?     @relation(fields: [flat_id], references: [flat_id], onDelete: Cascade)

  @@index([user_id], map: "Ownership_user_id_idx")
  @@index([plot_no], map: "Ownership_plot_no_idx")
  @@index([flat_id], map: "Ownership_flat_id_idx")
}

model OwnershipTransfer {
  transfer_id    Int      @id @default(autoincrement())
  from_user_id   Int
  to_user_id     Int
  plot_no        String
  flat_id        Int?
  reason         String
  notes          String?  @db.VarChar(500)
  transfer_date  DateTime @default(now())

  fromUser       Users    @relation("TransferFrom", fields: [from_user_id], references: [user_id], onDelete: Cascade)
  toUser         Users    @relation("TransferTo", fields: [to_user_id], references: [user_id], onDelete: Cascade)

  @@index([from_user_id], map: "OwnershipTransfer_from_idx")
  @@index([to_user_id], map: "OwnershipTransfer_to_idx")
}

model Fees {
  fee_id      Int           @id @default(autoincrement())
  user_id     Int
  month       DateTime
  amount_due  Decimal
  status      String
  feePayments FeePayments[]
  user        Users         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id], map: "Fees_user_id_fkey")
}

model FeePayments {
  payment_id     Int      @id @default(autoincrement())
  fee_id         Int
  amount_paid    Decimal
  payment_date   DateTime
  payment_method String
  transaction_id String?
  fee            Fees     @relation(fields: [fee_id], references: [fee_id], onDelete: Cascade)

  @@index([fee_id], map: "FeePayments_fee_id_fkey")
}

model PayrollAssignments {
  assignment_id      Int                  @id @default(autoincrement())
  staff_id           Int
  role               String
  base_amount        Decimal
  frequency          String
  start_date         DateTime
  end_date           DateTime?
  is_active          Boolean              @default(true)
  payrollAdjustments PayrollAdjustments[]
  staff              Users                @relation(fields: [staff_id], references: [user_id], onDelete: Cascade)
  payrollPayments    PayrollPayments[]

  @@index([staff_id], map: "PayrollAssignments_staff_id_fkey")
}

model PayrollAdjustments {
  adjustment_id Int                @id @default(autoincrement())
  assignment_id Int
  type          String
  amount        Decimal
  month         DateTime
  reason        String?
  assignment    PayrollAssignments @relation(fields: [assignment_id], references: [assignment_id], onDelete: Cascade)

  @@index([assignment_id], map: "PayrollAdjustments_assignment_id_fkey")
}

model PayrollPayments {
  payment_id     Int                @id @default(autoincrement())
  assignment_id  Int
  month          DateTime
  total_paid     Decimal
  payment_date   DateTime
  method         String
  transaction_id String?
  status         String
  assignment     PayrollAssignments @relation(fields: [assignment_id], references: [assignment_id], onDelete: Cascade)

  @@index([assignment_id], map: "PayrollPayments_assignment_id_fkey")
}

model Contributions {
  contribution_id      Int                    @id @default(autoincrement())
  title                String
  description          String?
  target_amount        Decimal
  collected_amount     Decimal?               @default(0.0)
  start_date           DateTime
  end_date             DateTime?
  status               String
  contributionPayments ContributionPayments[]
  expenses             Expenses[]
}

model ContributionPayments {
  payment_id      Int           @id @default(autoincrement())
  contribution_id Int
  user_id         Int
  amount          Decimal
  payment_date    DateTime
  payment_method  String
  transaction_id  String?
  contribution    Contributions @relation(fields: [contribution_id], references: [contribution_id], onDelete: Cascade)
  user            Users         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([contribution_id], map: "ContributionPayments_contribution_id_fkey")
  @@index([user_id], map: "ContributionPayments_user_id_fkey")
}

model Expenses {
  expense_id             Int            @id @default(autoincrement())
  category               String
  description            String?
  total_amount           Decimal
  paid_by                String
  payment_date           DateTime
  approved_by            Int
  linked_contribution_id Int?
  receipt_path           String?
  notes                  String?
  approvedBy             Users          @relation("ApprovedExpenses", fields: [approved_by], references: [user_id], onDelete: Cascade)
  contribution           Contributions? @relation(fields: [linked_contribution_id], references: [contribution_id], onDelete: Cascade)

  @@index([approved_by], map: "Expenses_approved_by_fkey")
  @@index([linked_contribution_id], map: "Expenses_linked_contribution_id_fkey")
}
