generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Users {
  user_id            Int     @id @default(autoincrement())
  name               String
  email              String  @unique
  phone              String?
  role               String
  blood_group        String?
  password_hash      String
  holding_no         String?
  plot_no            String?   @unique
  status             String    @default("pending")
  contributionPayments ContributionPayments[]
  expensesApproved     Expenses[] @relation("ApprovedExpenses")
  fees                 Fees[]
  payrollAssignments   PayrollAssignments[]

  // One-to-one relation to Plot
  assignedPlot       Plot?     @relation(fields: [plot_no], references: [plot_no])
}

model Plot {
  plot_no     String   @id
  owner_name  String
  size        Float    @default(0.0)
  is_assigned Boolean  @default(false)
  assigned_to Int?     @unique

  // Only back relation, no fields/references here
  assignedUser Users?  @relation
}


model Fees {
  fee_id      Int           @id @default(autoincrement())
  user_id     Int
  month       DateTime
  amount_due  Decimal
  status      String
  feePayments FeePayments[]
  user        Users         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id], map: "Fees_user_id_fkey")
}

model FeePayments {
  payment_id     Int      @id @default(autoincrement())
  fee_id         Int
  amount_paid    Decimal
  payment_date   DateTime
  payment_method String
  transaction_id String?
  fee            Fees     @relation(fields: [fee_id], references: [fee_id], onDelete: Cascade)

  @@index([fee_id], map: "FeePayments_fee_id_fkey")
}

model PayrollAssignments {
  assignment_id      Int                  @id @default(autoincrement())
  staff_id           Int
  role               String
  base_amount        Decimal
  frequency          String
  start_date         DateTime
  end_date           DateTime?
  is_active          Boolean              @default(true)
  payrollAdjustments PayrollAdjustments[]
  staff              Users                @relation(fields: [staff_id], references: [user_id], onDelete: Cascade)
  payrollPayments    PayrollPayments[]

  @@index([staff_id], map: "PayrollAssignments_staff_id_fkey")
}

model PayrollAdjustments {
  adjustment_id Int                @id @default(autoincrement())
  assignment_id Int
  type          String
  amount        Decimal
  month         DateTime
  reason        String?
  assignment    PayrollAssignments @relation(fields: [assignment_id], references: [assignment_id], onDelete: Cascade)

  @@index([assignment_id], map: "PayrollAdjustments_assignment_id_fkey")
}

model PayrollPayments {
  payment_id     Int                @id @default(autoincrement())
  assignment_id  Int
  month          DateTime
  total_paid     Decimal
  payment_date   DateTime
  method         String
  transaction_id String?
  status         String
  assignment     PayrollAssignments @relation(fields: [assignment_id], references: [assignment_id], onDelete: Cascade)

  @@index([assignment_id], map: "PayrollPayments_assignment_id_fkey")
}

model Contributions {
  contribution_id      Int                    @id @default(autoincrement())
  title                String
  description          String?
  target_amount        Decimal
  collected_amount     Decimal?               @default(0.0)
  start_date           DateTime
  end_date             DateTime?
  status               String
  contributionPayments ContributionPayments[]
  expenses             Expenses[]
}

model ContributionPayments {
  payment_id      Int           @id @default(autoincrement())
  contribution_id Int
  user_id         Int
  amount          Decimal
  payment_date    DateTime
  payment_method  String
  transaction_id  String?
  contribution    Contributions @relation(fields: [contribution_id], references: [contribution_id], onDelete: Cascade)
  user            Users         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([contribution_id], map: "ContributionPayments_contribution_id_fkey")
  @@index([user_id], map: "ContributionPayments_user_id_fkey")
}

model Expenses {
  expense_id             Int            @id @default(autoincrement())
  category               String
  description            String?
  total_amount           Decimal
  paid_by                String
  payment_date           DateTime
  approved_by            Int
  linked_contribution_id Int?
  receipt_path           String?
  notes                  String?
  approvedBy             Users          @relation("ApprovedExpenses", fields: [approved_by], references: [user_id], onDelete: Cascade)
  contribution           Contributions? @relation(fields: [linked_contribution_id], references: [contribution_id], onDelete: Cascade)

  @@index([approved_by], map: "Expenses_approved_by_fkey")
  @@index([linked_contribution_id], map: "Expenses_linked_contribution_id_fkey")
}
